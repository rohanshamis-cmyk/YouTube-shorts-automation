# ==========================================================
# Content Pack Generator - Active Environment Template
# Copy to .env and fill values
# ==========================================================

# --- Script generation provider routing (script_generator.py) ---
# Validation accepts either OPENAI_API_KEY (preferred) or ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional provider overrides for script generation
# SCRIPT_PROVIDER values: openai | anthropic | local
SCRIPT_PROVIDER=
SCRIPT_OPENAI_MODEL=gpt-4o-mini
SCRIPT_ANTHROPIC_MODEL=claude-opus-4-5
# Optional local Anthropic-compatible endpoint (example: Ollama proxy)
ANTHROPIC_BASE_URL=

# --- Voiceover (render_batch.py -> voiceover.py) ---
# Optional explicit voice provider routing:
#   auto (default): ElevenLabs -> OpenAI -> local fallback
#   elevenlabs: ElevenLabs first, then fallback providers
#   openai: OpenAI first, then local fallback
#   local: skip cloud providers in VoiceoverEngine and use render fallback path
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
# Optional explicit ElevenLabs voice override (preferred over VOICE_ID)
ELEVENLABS_VOICE_ID=
# Optional OpenAI TTS voice override (default: alloy)
OPENAI_TTS_VOICE=alloy
# Optional voice tuning
VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_STABILITY=0.5
VOICE_SIMILARITY=0.75

# --- Rendering / backgrounds ---
PEXELS_API_KEY=
# Optional style override: ai_student | trend_explainer | gameplay_story
SHORTS_STYLE=

# --- Batch behavior / niche ---
CHANNEL_NICHE=ai_tools
VIDEOS_PER_DAY=3

# --- YouTube upload path (upload_batch.py / uploader.py) ---
YOUTUBE_CLIENT_SECRETS=client_secrets.json
# Optional API key (used by parts of main.py live path)
YOUTUBE_API_KEY=
# NOTE: OAuth token is created at runtime as youtube_token.pickle

# --- Topic discovery (when not passing --topic) ---
REDDIT_CLIENT_ID=
REDDIT_SECRET=
PIXABAY_API_KEY=

# --- Optional integrations used by main.py live pipeline only ---
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_ID=
